export default function App() {
  const [screen, setScreen] = useState('login');
  const [email, setEmail] = useState('');
  const [pass, setPass] = useState('');
  const [units, setUnits] = useState('YARDS');
  const [clubs, setClubs] = useState(CLUBS.map(x => [...x]));
  
  const [coords, setCoords] = useState({ latitude: -27.4512, longitude: 153.0251 });
  const [weather, setWeather] = useState({ temp: '--', windSpeed: 0, windDir: 0, cardinal: 'SCANNING' });
  const [loadingWeather, setLoadingWeather] = useState(false);
  const [holeNo, setHoleNo] = useState(1);
  const [isListening, setIsListening] = useState(false);
  const [caddieSpeech, setCaddieSpeech] = useState("Awaiting environmental metrics initialization standard...");
  const [calculatedDistances, setCalculatedDistances] = useState({ front: 146, centre: 154, back: 162, dynamicMode: false });

  const windAnim = useRef(new Animated.Value(0)).current;
  const currentCourseConfig = COURSE_DATABASE[holeNo] || COURSE_DATABASE;

  useEffect(() => {
    let subscription;
    (async () => {
      let { status } = await Location.requestForegroundPermissionsAsync();
      if (status !== 'granted') {
        setCaddieSpeech("GPS Permission Denied. Running fallback localized profile telemetry.");
        return;
      }
      
      subscription = await Location.watchPositionAsync(
        { accuracy: Location.Accuracy.High, distanceInterval: 2 },
        (loc) => {
          setCoords({
            latitude: loc.coords.latitude,
            longitude: loc.coords.longitude
          });
        }
      );
    })();

    return () => {
      if (subscription) subscription.remove();
    };
  }, []);

  useEffect(() => {
    if (!coords.latitude) return;

    const realTimeDistance = calculateDistanceMatrix(
      coords.latitude,
      coords.longitude,
      currentCourseConfig.targetLat,
      currentCourseConfig.targetLon,
      units
    );

    if (realTimeDistance && realTimeDistance < 5000) {
      setCalculatedDistances({
        front: Math.max(10, realTimeDistance - 10),
        centre: realTimeDistance,
        back: realTimeDistance + 10,
        dynamicMode: true
      });
    } else {
      setCalculatedDistances({
        front: currentCourseConfig.defaultFront,
        centre: currentCourseConfig.defaultCentre,
        back: currentCourseConfig.defaultBack,
        dynamicMode: false
      });
    }
  }, [coords, holeNo, units]);

  useEffect(() => {
    if (!coords.latitude) return;

    const fetchLiveMetrics = async () => {
      setLoadingWeather(true);
      try {
        const response = await fetch(
          `https://open-meteo.com{coords.latitude}&longitude=${coords.longitude}&current=temperature_2m,wind_speed_10m,wind_direction_10m`
        );
        const data = await response.json();
        if (data && data.current) {
          const wSpeed = Math.round(data.current.wind_speed_10m);
          const wDir = data.current.wind_direction_10m;
          const temp = Math.round(data.current.temperature_2m);
          const card = getWindDirection(wDir);

          setWeather({ temp, windSpeed: wSpeed, windDir: wDir, cardinal: card });
          
          setCaddieSpeech(
            `Metrics confirmed. We have a ${wSpeed} km/h wind blowing out of the ${card}. Temperature is ${temp}°C. Your density profile looks crisp. Keep the ball flight low to maximize rollout.`
          );
        }
      } catch (err) {
        console.log("Telemetry Error:", err);
      } finally {
        setLoadingWeather(false);
      }
    };

    fetchLiveMetrics();
  }, [coords]);

  useEffect(() => {
    windAnim.setValue(0);
    Animated.timing(windAnim, {
      toValue: weather.windDir,
      duration: 1200,
      easing: Easing.out(Easing.quad),
      useNativeDriver: true
    }).start();
  }, [weather.windDir]);

  const windRotation = windAnim.interpolate({
    inputRange:,
    outputRange: ['0deg', '360deg']
  });

  const go = x => setScreen(x);

  const toggleMicSimulate = () => {
    if (!isListening) {
      setIsListening(true);
      setCaddieSpeech("Processing audio signals against live local vectors...");
      setTimeout(() => {
        setIsListening(false);
        setCaddieSpeech(
          `Affirmative. Accounting for the ${weather.windSpeed} km/h wind from the ${weather.cardinal}, the true playing distance shifts. Avoid a full release—smooth tempo down the middle.`
        );
      }, 2500);
    }
  };

  const Login = () => (
    <View style={s.login}>
      <HeroBrand />
      <View style={s.loginCard}>
        <Text style={s.welcome}>AUTHENTICATE OPERATOR</Text>
        <Text style={s.signSub}>Sync premium telemetry suite</Text>
        <Text style={s.lab}>PRO PROFILE EMAIL</Text>
        <TextInput style={s.input} value={email} onChangeText={setEmail} placeholder="dale@elitegolf.com" placeholderTextColor={C.muted} />
        <Text style={s.lab}>ENCRYPTED SECURITY KEY</Text>
        <TextInput style={s.input} value={pass} onChangeText={setPass} secureTextEntry placeholder="••••••••" placeholderTextColor={C.muted} />
