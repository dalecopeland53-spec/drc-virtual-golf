{
  "expo": {
    "name": "DRC Virtual Golf Elite",
    "slug": "drc-virtual-golf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DRC Virtual Golf uses your location to calculate live on-course distances and show your position on the golf hole."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drc.virtualgolfelite",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DRC Virtual Golf uses your location to calculate live on-course distances and show your position on the golf hole."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "package": "com.drc.virtualgolfelite",
      "adaptiveIcon": {
        "foregroundImage": "./drc-virtual-golf-icon.png",
        "backgroundColor": "#031827"
      }
    },
    "icon": "./drc-virtual-golf-icon.png"
  }
}
