    </View>
  );

  const Home = () => (
    <View style={s.page}>
      <View style={s.homeHead}>
        <Logo small secret={() => go('secret')} />
        <View style={{ flex: 1 }}>
          <Text style={s.hello}>SYSTEM ONLINE • USER: DALE</Text>
          <Text style={s.ready}>Pete is tracking your trajectory.</Text>
        </View>
        <View style={s.avatar}><Text style={s.avatarT}>D</Text></View>
      </View>

      <View style={s.weatherRibbon}>
        <View style={s.weatherBlock}>
          <Text style={s.weatherLabel}>LIVE ATMOSPHERE</Text>
          <Text style={s.weatherValue}>{weather.temp}°C • Streamed</Text>
        </View>
        <View style={s.weatherDivider} />
        <View style={s.weatherBlock}>
          <Text style={s.weatherLabel}>TRUE VELOCITY MATRIX</Text>
          <Text style={s.weatherValue}>{weather.windSpeed} km/h • {weather.cardinal}</Text>
        </View>
      </View>

      <TouchableOpacity style={s.hero} onPress={() => go('round')}>
        <View style={s.heroShade}>
          <Text style={s.heroTitle}>ENGAGE LIVE APP LINK</Text>
          <Text style={s.heroSub}>Hole {holeNo} Telemetry Buffer Active</Text>
          <View style={s.heroBtn}><Text style={s.heroBtnT}>ENTER COGNITIVE COCKPIT  ›</Text></View>
        </View>
      </TouchableOpacity>

      <View style={s.grid}>
