{
  "expo": {
    "name": "DRC Virtual Golf Elite",
    "slug": "drc-virtual-golf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./drc-virtual-golf-icon.png",
    "userInterfaceStyle": "light",
    "plugins": ["expo-speech-recognition"],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#C7C2BB"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./drc-virtual-golf-icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DRC Virtual Golf uses your location for on-course GPS.",
        "NSMicrophoneUsageDescription": "DRC Virtual Golf uses the microphone when you tap Ask Pete.",
        "NSSpeechRecognitionUsageDescription": "DRC Virtual Golf uses speech recognition when you tap Ask Pete."
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./drc-virtual-golf-icon.png",
        "backgroundColor": "#C7C2BB"
      },
      "package": "com.dalecopeland.drcvirtualgolf"
    },
    "owner": "raffa68s-team"
  }
}
