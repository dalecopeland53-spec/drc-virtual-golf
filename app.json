{
  "expo": {
    "name": "DRC Virtual Golf Elite",
    "slug": "drc-virtual-golf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./drc-virtual-golf-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#D8D0C2"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalecopeland53.drcvirtualgolf"
    },
    "android": {
      "package": "com.dalecopeland53.drcvirtualgolf",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./drc-virtual-golf-icon.png",
        "backgroundColor": "#D8D0C2"
      }
    },
    "web": {
      "favicon": "./drc-virtual-golf-icon.png"
    }
  }
}
