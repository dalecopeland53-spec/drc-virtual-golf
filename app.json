{
  "expo": {
    "name": "DRC Virtual Golf",
    "slug": "drc-virtual-golf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./drc-virtual-golf-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#03081e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./drc-virtual-golf-icon.png",
        "backgroundColor": "#03081e"
      },
      "package": "com.dalecopeland.drcvirtualgolf"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow DRC Virtual Golf to use the microphone.",
          "speechRecognitionPermission": "Allow DRC Virtual Golf to use speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "web": {}
  }
}
