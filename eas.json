// Haversine core trigonometry system to translate GPS variances into raw layout metrics
const calculateDistanceMatrix = (lat1, lon1, lat2, lon2, targetUnit) => {
  if (!lat1 || !lon1 || !lat2 || !lon2) return null;
  const R = 6371e3; // Earth radius in metres
  const phi1 = (lat1 * Math.PI) / 180;
  const phi2 = (lat2 * Math.PI) / 180;
  const deltaPhi = ((lat2 - lat1) * Math.PI) / 180;
  const deltaLambda = ((lon2 - lon1) * Math.PI) / 180;

  const a = Math.sin(deltaPhi / 2) * Math.sin(deltaPhi / 2) +
            Math.cos(phi1) * Math.cos(phi2) *
            Math.sin(deltaLambda / 2) * Math.sin(deltaLambda / 2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  const distanceInMetres = R * c;

  // Convert distance output based on user's baseline preferences
  if (targetUnit === 'YARDS') {
    return Math.round(distanceInMetres * 1.09361);
  }
  return Math.round(distanceInMetres);
};

const getWindDirection = (deg) => {
  const src = ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'];
  return src[Math.round(deg / 22.5) % 16];
};

